{
  "name": "sand-bucket",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "generate:level": "node --experimental-strip-types scripts/generate-level.ts",
    "test:full": "SAND_BUCKET_FULL_TESTS=1 vitest run"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
